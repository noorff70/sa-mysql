<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- Log file location: set LOG_PATH (env var or -DLOG_PATH=...) to change it,
         e.g. c:/temp/sa-mysql.log. Defaults to logs/sa-mysql.log in the working directory. -->
    <property name="LOG_FILE" value="${LOG_PATH:-logs/sa-mysql.log}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d %p %c{1.} [%t] %m%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE-ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/archived/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- each archived file, size max 5MB -->
            <maxFileSize>5MB</maxFileSize>
            <!-- total size of all archive files; older archives are deleted beyond this -->
            <totalSizeCap>10MB</totalSizeCap>
            <!-- 60 days to keep -->
            <maxHistory>60</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d %p %c{1.} [%t] %m%n</pattern>
        </encoder>
    </appender>

    <!-- this service's own code (package com.sa.ui): info and above -->
    <logger name="com.sa.ui" level="info" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE-ROLLING"/>
    </logger>

    <!-- libraries (Spring, Hikari, Eureka...): warnings and errors -->
    <root level="warn">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE-ROLLING"/>
    </root>

</configuration>
